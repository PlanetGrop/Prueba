# Configure these in your hosting service's private environment settings.
NODE_ENV=production
TRUST_PROXY=1
# Render supplies RENDER_EXTERNAL_URL automatically. Set APP_URL for a custom domain.
APP_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Each account must also have private read access to the Google spreadsheet.
GOOGLE_ALLOWED_EMAILS=
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_TAB=
# Generate a random key of at least 32 characters; never commit the real key.
SESSION_SECRET=
SESSION_DB_PATH=/tmp/clave/sessions.sqlite
