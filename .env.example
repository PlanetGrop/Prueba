# Copy to .env; do not commit real values.
PORT=3000
APP_URL=http://localhost:3000
# Set all four Google values to enable Google access. Otherwise the app uses fake demo data.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ALLOWED_EMAIL=
GOOGLE_SPREADSHEET_ID=
# Optional: without it a secure random session key is generated at each startup.
SESSION_SECRET=
# Optional: exact tab name; leave empty to use the first tab.
GOOGLE_SHEET_TAB=
# Set to production only behind HTTPS. Configure a trusted reverse proxy if needed.
NODE_ENV=development
# Set to 1 only behind a single trusted reverse proxy.
TRUST_PROXY=0
